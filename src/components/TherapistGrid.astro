---
/**
 * Therapist cards - photo, name, speciality, short description and two
 * contact buttons (call and WhatsApp).
 *
 * Used twice - the home page and /gallery/ - and both read the same array from
 * src/data/reviews.ts, so a therapist is edited in one place only.
 *
 * The cards carry no country badge: Russian and Indian therapists are split
 * into two groups by the heading above each grid instead.
 *
 * There is no star rating here on purpose: a rating the business writes about
 * its own staff is not a real review. Do not add one back.
 *
 * Both buttons are built from the single number in src/data/site.ts - never
 * hard-code a phone number here.
 */
import { telHref, whatsappHref, site } from '../data/site';
import { homeImage } from '../data/home-images';
import type { Therapist } from '../data/reviews';

interface Props {
  people: readonly Therapist[];
  /** Heading level, so each page keeps a correct h2 -> h3 outline. */
  headingLevel?: 'h3' | 'h4';
  /** Eager-load the first N photos when the grid sits high on the page. */
  eagerCount?: number;
}

const { people, headingLevel = 'h3', eagerCount = 0 } = Astro.props;
const Heading = headingLevel;

---

<ul class="team">
  {
    people.map((person, index) => {
      const photo = homeImage(person.image);
      /*
        Alt describes the photo, not the person: these are still placeholder
        stock portraits, so naming the therapist would describe something the
        image is not. The name is real text on the card already.
      */
      const alt = `${person.origin} massage therapist at Russian Spa Mahipalpur`;
      const bookingMessage = `Hi, I would like to book a session with ${person.name}, our ${person.origin} ${person.role} therapist.`;
      return (
        <li class="team__card">
          <div class="team__photo">
            <img
              src={photo.src}
              alt={alt}
              width={photo.width}
              height={photo.height}
              loading={index < eagerCount ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>

          <div class="team__body">
            <Heading class="team__name">{person.name}</Heading>
            <p class="team__role">{person.role}</p>

            <p class="team__text">{person.description}</p>

            <div class="team__actions">
              <a class="team__btn team__btn--call" href={telHref} aria-label={`Call ${site.phone} to book ${person.name}`}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .7-.2 1z" />
                </svg>
                <span>Call</span>
              </a>

              <a
                class="team__btn team__btn--wa"
                href={whatsappHref(bookingMessage)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Book ${person.name} on WhatsApp`}
              >
                <svg viewBox="0 0 32 32" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d="M16 3C8.8 3 3 8.8 3 16c0 2.3.6 4.5 1.7 6.4L3 29l6.8-1.8A13 13 0 1 0 16 3m0 23.7c-2.1 0-4.1-.6-5.9-1.6l-.4-.3-4 1 1.1-3.9-.3-.4A10.7 10.7 0 1 1 16 26.7m6-8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-1.2 1.2-1.2 2.9-1.1 3.1s1.7 3.9 4.6 5.6c2.2 1.3 3.2 1.4 4 1.3.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5z" />
                </svg>
                <span>WhatsApp</span>
              </a>
            </div>
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team__card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--green-100);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .team__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .team__photo img {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
  }

  .team__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.05rem 1.1rem 1.2rem;
    text-align: center;
  }

  .team__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--green-800);
  }

  .team__role {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-700);
  }

  .team__text {
    margin: 0.2rem 0 0;
    flex: 1;
    font-size: 0.87rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .team__actions {
    display: flex;
    gap: 0.55rem;
    margin-top: 0.9rem;
  }

  .team__btn {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 40px;
    padding: 0.45rem 0.6rem;
    border-radius: 999px;
    color: var(--white);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }

  .team__btn:hover {
    transform: translateY(-2px);
  }

  .team__btn--call {
    background: var(--green-700);
  }

  .team__btn--call:hover {
    background: var(--green-800);
  }

  .team__btn--wa {
    background: var(--whatsapp);
  }

  .team__btn--wa:hover {
    background: var(--whatsapp-dark);
  }

  /* Labels are dropped on very narrow cards so the two buttons still fit. */
  @media (max-width: 380px) {
    .team__btn span {
      display: none;
    }
  }
</style>
