---
/**
 * Site footer: service-area strip, brand column, quick links, outlets,
 * contact block and the copyright line.
 */
import { site, footerQuickLinks, telHref, mailHref } from '../data/site';
import { footerOutlets, serviceAreas } from '../data/locations';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<!-- Areas we serve - plain text, kept above the footer as in the design. -->
<section class="areas" aria-label="Areas we serve">
  <div class="container">
    <ul class="areas__list">
      {serviceAreas.map((area) => <li>{area}</li>)}
    </ul>
  </div>
</section>

<footer class="footer">
  <div class="container container--wide">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__logo" href="/" aria-label={`${site.name} home`}>
          <picture>
            <source srcset={site.logo.markWebp} type="image/webp" />
            <img
              class="footer__mark"
              src={site.logo.markPng}
              alt=""
              width={site.logo.markSize}
              height={site.logo.markSize}
              loading="lazy"
              decoding="async"
            />
          </picture>
          <span class="footer__wordmark">
            <span>{site.logo.line1}</span>
            <span>{site.logo.line2}</span>
          </span>
        </a>
        <p>{site.tagline}</p>
        <SocialLinks class="footer__socials" size={18} />
      </div>

      <nav class="footer__col" aria-label="Quick links">
        <h2 class="footer__title">Quick Links</h2>
        <ul>
          {footerQuickLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Our outlets">
        <h2 class="footer__title">Outlets</h2>
        <ul>
          {footerOutlets.map((outlet) => <li><a href={outlet.href}>{outlet.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__title">Get in Touch</h2>
        <address class="footer__address">
          <span>{site.addressLine}</span>
          <a href={mailHref}>{site.email}</a>
          <a href={telHref}>{site.phone}</a>
          <span class="footer__hours">{site.openingHoursLabel}</span>
        </address>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  /* ------------------------------------------------------- area strip */
  .areas {
    background: var(--green-050);
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .areas__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    margin: 0;
  }

  .areas__list li {
    font-size: 0.76rem;
    color: var(--muted);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
  }

  /* ----------------------------------------------------------- footer */
  .footer {
    background: var(--green-900);
    color: rgba(255, 255, 255, 0.78);
    padding-block: clamp(2.25rem, 1.8rem + 1.8vw, 3.5rem) 1.25rem;
    font-size: 0.86rem;
  }

  .footer__grid {
    display: grid;
    gap: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    }
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .footer__mark {
    width: 40px;
    height: 40px;
    flex: none;
    object-fit: contain;
  }

  .footer__wordmark {
    display: grid;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    line-height: 1.1;
    color: var(--white);
  }

  .footer__brand p {
    max-width: 38ch;
  }

  .footer__socials {
    margin-top: 1.1rem;
  }

  .footer__title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: var(--white);
    margin-bottom: 1rem;
  }

  .footer__col ul {
    display: grid;
    gap: 0.6rem;
  }

  .footer__col a:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .footer__address {
    display: grid;
    gap: 0.7rem;
    font-style: normal;
  }

  .footer__hours {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.8rem;
  }

  .footer__bottom {
    margin-top: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    text-align: center;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.62);
  }
</style>
