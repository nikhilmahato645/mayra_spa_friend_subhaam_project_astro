---
/**
 * Social media icon row.
 *
 * Reads src/data/site.ts - change a URL there once and it updates in the
 * header, the footer and the JSON-LD `sameAs` list at the same time.
 */
import { site } from '../data/site';

interface Props {
  /** Extra class for positioning. */
  class?: string;
  /** Icon size in px. */
  size?: number;
}

const { class: className = '', size = 16 } = Astro.props;

/** Inline SVG paths - no icon font, no extra network request. */
