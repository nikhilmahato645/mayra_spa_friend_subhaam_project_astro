---
/**
 * Floating contact buttons, present on every page:
 *   WhatsApp bottom-left, call bottom-right (as in the design).
 *
 * Both appear with a small pop once the visitor starts scrolling, so they do
 * not cover the hero on first load.
 */
import { whatsappHref, telHref, site } from '../data/site';
---

<div class="floats" data-floats>
  <a
    class="float float--wa"
    href={whatsappHref('Hi, I would like to know more about your spa services.')}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with us on WhatsApp"
  >
    <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true">
      <path
        d="M16 3C8.8 3 3 8.8 3 16c0 2.3.6 4.5 1.7 6.4L3 29l6.8-1.8A13 13 0 1 0 16 3m0 23.7c-2.1 0-4.1-.6-5.9-1.6l-.4-.3-4 1 1.1-3.9-.3-.4A10.7 10.7 0 1 1 16 26.7m6-8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-1.2 1.2-1.2 2.9-1.1 3.1s1.7 3.9 4.6 5.6c2.2 1.3 3.2 1.4 4 1.3.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5z"
      ></path>
    </svg>
  </a>

  <a class="float float--call" href={telHref} aria-label={`Call us on ${site.phone}`}>
    <svg viewBox="0 0 24 24" width="25" height="25" fill="currentColor" aria-hidden="true">
      <path
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .7-.2 1z"
      ></path>
    </svg>
  </a>
</div>

<style>
  .floats {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-float);
    pointer-events: none;
  }

  .float {
    position: fixed;
    bottom: 18px;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: var(--white);
    pointer-events: auto;
    /* Hidden until the visitor scrolls. */
    opacity: 0;
    transform: scale(0.6) translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.2s ease;
  }

  .floats.is-visible .float {
    opacity: 1;
    transform: none;
  }

  .float--wa {
    left: 16px;
    background: var(--whatsapp);
    box-shadow: 0 8px 22px rgba(37, 211, 102, 0.42);
    border-radius: 14px;
  }

  .float--wa:hover {
    background: var(--whatsapp-dark);
  }

  .float--call {
    right: 16px;
    background: var(--whatsapp);
    box-shadow: 0 8px 22px rgba(37, 211, 102, 0.42);
    transition-delay: 0.06s;
  }

  .float--call:hover {
    background: var(--whatsapp-dark);
  }

  /* A gentle pulse ring on the call button to draw the eye. */
  .float--call::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--whatsapp);
    animation: float-pulse 2.4s ease-out infinite;
  }

  @keyframes float-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70% {
      transform: scale(1.5);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    .float {
      width: 48px;
      height: 48px;
      bottom: 14px;
    }
    .float--wa {
      left: 12px;
    }
    .float--call {
      right: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .float--call::before {
      animation: none;
    }
  }
</style>

<script>
  // Reveal the buttons after a little scrolling.
  const floats = document.querySelector('[data-floats]');
  let pending = false;

  function update() {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => {
      floats?.classList.toggle('is-visible', window.scrollY > 120);
      pending = false;
    });
  }

  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
