---
/**
 * LocationLayout - the shared skeleton behind all ten
 * /russian-spa-in-<area>/ landing pages.
 *
 * A location page file is only three lines; everything it shows comes from its
 * entry in src/data/locations.ts. Sections with no copy yet are skipped, so a
 * page never renders an empty heading.
 *
 * TO PUBLISH ONE AREA
 *   1. fill in `intro`, `sections` and `faqs` for that slug in locations.ts;
 *   2. remove its path from src/data/drafts.mjs (that lifts `noindex` and adds
 *      the page to the sitemap).
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { site, telHref } from '../data/site';
import { getLocation } from '../data/locations';
import { services } from '../data/services';
import { pageHeroes, servicePhoto } from '../data/page-images';
import { breadcrumbTrail } from '../utils/seo';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../utils/schema';
import { isDraft } from '../data/drafts.mjs';

interface Props {
  /** Slug of the entry in src/data/locations.ts. */
  slug: string;
}

const { slug } = Astro.props;
const location = getLocation(slug);

const crumbs = breadcrumbTrail([
  { name: 'Outlets', href: '/russian-spa-in-mahipalpur/' },
  { name: location.heading, href: `/${location.slug}/` },
]);

const schemas = [
  breadcrumbSchema(crumbs),
  faqSchema(location.faqs),
  serviceSchema({
    name: `Massage spa in ${location.area}`,
    description: location.metaDescription,
    url: `${site.url}/${location.slug}/`,
    areaServed: location.area,
  }),
];
---

<BaseLayout
  title={location.metaTitle}
  description={location.metaDescription}
  schemas={schemas}
  noindex={isDraft(Astro.url.pathname)}
  bareTitle
>
  <!--
    The trail goes ABOVE the hero, directly under the header, which is where
    the Aerocity, Gurgaon and Vasant Kunj pages put it. Every outlet page now
    shows "Home / Outlets / Russian Spa in <area>" in the same position, so
    PageHero is not given the `breadcrumbs` prop here.
  -->
  <Breadcrumbs items={crumbs} />

  <PageHero
    title={location.heading}
    subtitle={location.intro || undefined}
    image={pageHeroes.location}
  />

  <!-- ------------------------------------------ client copy (if present) -->
  {
    location.sections.length > 0 && (
      <section class="section">
        <div class="container prose">
          {location.sections.map((section) => (
            <article class="prose__block">
              <h2>{section.heading}</h2>
              <p>{section.body}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- ---------------------------------------------- services in this area -->
  <section class="section section--cream">
    <div class="container">
      <div class="section__head">
        <h2>Massage Services Available Near {location.area}</h2>
        <p>
          Every therapy below is available for guests visiting from {location.area} and the
          surrounding Delhi NCR areas.
        </p>
      </div>

      <div class="grid services-grid">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.description}
              image={servicePhoto(service.image)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------- FAQ (if present) -->
  {
    location.faqs.length > 0 && (
      <section class="section">
        <div class="container faq-wrap">
          <div class="section__head">
            <h2>{location.area} Spa - Frequently Asked Questions</h2>
          </div>
          <FAQ faqs={location.faqs} />
        </div>
      </section>
    )
  }

  <!-- ---------------------------------------------------------- book CTA -->
  <section class="section section--dark">
    <div class="container text-center">
      <h2>Book Your Session Near {location.area}</h2>
      <p class="lead">
        Send us a message on WhatsApp or call {site.phone} and our team will confirm your
        appointment and share the closest outlet.
      </p>
      <div class="cta-row">
        <CTA
          label="Chat on WhatsApp"
          message={`Hi, I would like to book a massage appointment near ${location.area}.`}
        />
        <a class="btn btn--light" href={telHref}>Call {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 820px;
  }

  .prose__block + .prose__block {
    margin-top: 2.5rem;
  }

  .prose h2 {
    margin-bottom: 1rem;
  }

  .services-grid {
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  }

  .faq-wrap {
    max-width: 900px;
  }

  .lead {
    max-width: 62ch;
    margin: 1rem auto 0;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
