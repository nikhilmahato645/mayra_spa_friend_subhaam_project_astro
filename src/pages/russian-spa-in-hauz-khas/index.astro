---
/**
 * LOCATION PAGE - /russian-spa-in-hauz-khas/
 *
 * WHY THIS ONE IS NOT A LocationLayout PAGE
 *
 * LocationLayout assumes the area it is handed is somewhere we trade from and
 * prints "Massage Services Available Near <area>" around it. There is no Hauz
 * Khas outlet - the business has ONE address, in Aerocity (see `site.address`)
 * - so this is a page for people SEARCHING from Hauz Khas and the South Delhi
 * neighbourhoods around it. That needs a shape the shared skeleton does not
 * have: a hero that says where we actually are, a treatment chooser, the banya
 * broken into its stages, and a location block pointing at the real address.
 *
 * IT IS ALSO NOT THE AEROCITY PAGE RENAMED. Aerocity leads with a split hero
 * and its address; this page leads with a centred hero over a full-width photo
 * band, then runs an asymmetric intro, a chooser grid whose photo tile sits
 * inside the cards, a dark banya stage rail, a "tell the therapist first"
 * checklist and a two-up local-search band - none of which exist on any other
 * location page.
 *
 * ALL COPY lives in src/data/hauz-khas.ts, along with the list of claims that
 * are banned on this page. Do not write prose into this file.
 *
 * STRUCTURED DATA: BaseLayout already emits DaySpa (the REAL Aerocity
 * address) + WebSite + WebPage on every page. This page adds only breadcrumbs,
 * the FAQ verbatim and a Service whose areaServed is Hauz Khas. There is no
 * second LocalBusiness and no Hauz Khas address anywhere in the graph - a
 * LocalBusiness pinned to an area the business does not trade from is exactly
 * what Google penalises.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import { site, telHref } from '../../data/site';
import {
  hauzKhasMeta,
  hauzKhasImages,
  hauzKhasTreatments,
  banyaStages,
  preferencePoints,
  nearbyAreas,
  hauzKhasPrices,
  hauzKhasFacilities,
  expectPoints,
  hauzKhasSteps,
  hauzKhasFaqs,
} from '../../data/hauz-khas';
import { variants, srcSet } from '../../utils/image';
import { breadcrumbTrail } from '../../utils/seo';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../utils/schema';
import { isDraft } from '../../data/drafts.mjs';

const crumbs = breadcrumbTrail([
  { name: 'Outlets', href: '/russian-spa-in-mahipalpur/' },
  { name: 'Russian Spa in Hauz Khas', href: '/russian-spa-in-hauz-khas/' },
]);

const schemas = [
  breadcrumbSchema(crumbs),
  faqSchema(hauzKhasFaqs),
  serviceSchema({
    name: 'Russian spa and body massage for guests from Hauz Khas',
    description: hauzKhasMeta.description,
    url: `${site.url}/russian-spa-in-hauz-khas/`,
    areaServed: 'Hauz Khas, South Delhi',
  }),
];

/*
 * The same embed the contact page builds: the Google Business Profile
 * addressed by its CID, so there is no hand-written latitude or longitude
 * anywhere and no API key in the front end. It points at the REAL Aerocity
 * address - there is no Hauz Khas pin to drop.
 */
const mapSrc = `${site.mapsUrl.replace('https://maps.google.com/?', 'https://www.google.com/maps?')}&output=embed`;

/** Line icons for the facilities grid, keyed by `icon` in the data file. */
const facilityIcons: Record<string, string> = {
  room: 'M3 21V9l9-6 9 6v12h-7v-6h-4v6zm2-2h3v-6h8v6h3V10.1l-7-4.67-7 4.67z',
  shower:
    'M12 2a5 5 0 0 0-5 5v2H5v2h14V9h-2V7a5 5 0 0 0-5-5m-3 5a3 3 0 0 1 6 0v2H9zM7 14h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2zM7 18h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z',
  steam:
    'M8 3c1.5 1.5 1.5 3 0 4.5S6.5 10 8 11.5M12 3c1.5 1.5 1.5 3 0 4.5s-1.5 2.5 0 4M16 3c1.5 1.5 1.5 3 0 4.5s-1.5 2.5 0 4M4 15h16v2a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z',
  sauna: 'M3 4h18v2H3zm0 4h18v2H3zm0 4h18v2H3zm2 4h14v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z',
  hammam: 'M4 12a8 8 0 0 1 16 0v1H4zm-1 3h18v2H3zm2 4h14v2H5zM11 3h2v3h-2z',
  jacuzzi:
    'M5 11V6a2 2 0 0 1 4 0v1H7v2h4V6a4 4 0 0 0-8 0v5H2v2h20v-2zM3 15h18v3a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z',
};

const hero = hauzKhasImages.hero;
const heroArt = variants(hero.src);
const massageArt = variants(hauzKhasImages.massage.src);
const oilsArt = variants(hauzKhasImages.oils.src);
const calmArt = variants(hauzKhasImages.calm.src);
const bookingArt = variants(hauzKhasImages.booking.src);
---

<BaseLayout
  title={hauzKhasMeta.title}
  description={hauzKhasMeta.description}
  schemas={schemas}
  noindex={isDraft(Astro.url.pathname)}
  usesUnsplash={false}
  bareTitle
>
  <Breadcrumbs items={crumbs} />

  <!-- ===================================================== 1. HERO ====== -->
  <!--
    Centred copy on cream, with the photograph below it as a full-width band
    that the next section rises over. Not the home page's overlay banner and
    not the split hero the Aerocity page uses. The photo is the page's Largest
    Contentful Paint, so it is eager with fetchpriority.
  -->
  <section class="hkhero">
    <div class="container hkhero__copy">
      <p class="hkhero__eyebrow">South Delhi &middot; by appointment</p>
      <h1>Russian Spa in Hauz Khas</h1>
      <p class="hkhero__sub">Body Massage &amp; Spa Services Near Hauz Khas</p>
      <p class="hkhero__lead">
        Comparing the massage options around Hauz Khas? Our menu runs from a light Swedish hour to
        firm deep tissue work and the traditional Russian banya, and every session is booked ahead
        rather than walked into. We trade from one address &mdash; Northern Access Road in Aerocity,
        New Delhi &mdash; and take bookings from across South Delhi. Message us to check what is
        free.
      </p>

      <div class="hkhero__actions">
        <CTA
          label="Book on WhatsApp"
          message="Hi, I am searching from the Hauz Khas area and would like to book a massage."
        />
        <a class="btn btn--outline" href="/services/">Explore Massage Services</a>
      </div>

      <ul class="hkhero__facts">
        <li>Open daily, 9:00 AM &ndash; 11:00 PM</li>
        <li>One address, in Aerocity</li>
        <li>WhatsApp or phone booking</li>
      </ul>
    </div>

    <div class="hkhero__band">
      <picture>
        <source
          type="image/webp"
          srcset={srcSet(heroArt.webpSmall, heroArt.webp, 760, 1600)}
          sizes="100vw"
        />
        <img
          src={hero.src}
          srcset={srcSet(heroArt.jpgSmall, hero.src, 760, 1600)}
          sizes="100vw"
          alt={hero.alt}
          width={hero.width}
          height={hero.height}
          loading="eager"
          fetchpriority="high"
        />
      </picture>
    </div>
  </section>

  <!-- ============================================ 2. SERVICES NEAR HK ==== -->
  <!-- Asymmetric: the heading holds the left column, the prose the right. -->
  <section class="section hkintro" aria-labelledby="services-heading">
    <div class="container hkintro__grid">
      <div class="hkintro__head">
        <h2 id="services-heading">Massage &amp; Spa Services Near Hauz Khas</h2>
        <p class="hkintro__note">
          A menu wide enough that the choice is genuinely yours, not whatever is free.
        </p>
      </div>

      <div class="hkintro__body">
        <p>
          People searching around Hauz Khas rarely want the same thing. Some want an hour of light,
          flowing work and nothing more demanding; some want firm pressure held on the one shoulder
          that has not loosened in weeks; others are curious about the banya and want a heat ritual
          instead of a table. The menu covers all three, in sessions from forty-five minutes to two
          hours, so the length fits the evening you have.
        </p>
        <p>
          Every treatment is given in a private room, at a pressure you agree with the therapist
          beforehand. Because we run on appointments, the room and the time are held for you once
          the team confirms them &mdash; worth knowing if you are travelling in from elsewhere in
          South Delhi after work.
        </p>
      </div>
    </div>
  </section>

  <!-- ================================================= 3. TREATMENTS ==== -->
  <section class="section section--cream" aria-labelledby="treatments-heading">
    <div class="container">
      <div class="section__head">
        <h2 id="treatments-heading">Massage Treatments Near Hauz Khas</h2>
        <p class="muted">
          Six of the most asked-for sessions, with what each one actually feels like. The rest of
          the menu is on the services page.
        </p>
      </div>

      <ul class="chooser">
        <!-- The photo sits inside the grid as a tile, not above it. -->
        <li class="chooser__photo">
          <picture>
            <source
              type="image/webp"
              srcset={srcSet(massageArt.webpSmall, massageArt.webp, 460, 1000)}
              sizes="(min-width: 900px) 360px, 92vw"
            />
            <img
              src={hauzKhasImages.massage.src}
              srcset={srcSet(massageArt.jpgSmall, hauzKhasImages.massage.src, 460, 1000)}
              sizes="(min-width: 900px) 360px, 92vw"
              alt={hauzKhasImages.massage.alt}
              width={hauzKhasImages.massage.width}
              height={hauzKhasImages.massage.height}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </li>

        {
          hauzKhasTreatments.map((treatment) => (
            <li class="ccard">
              <div class="ccard__top">
                <h3>{treatment.name}</h3>
                <p class="ccard__meta">
                  <span class="ccard__price">{treatment.price}</span>
                  <span class="ccard__dur">{treatment.duration}</span>
                </p>
              </div>
              <p class="ccard__text">{treatment.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="centre-row">
        <a class="btn btn--outline" href="/services/">View All Massage Services</a>
      </div>
    </div>
  </section>

  <!-- ======================================================= 4. BANYA ==== -->
  <!-- A dark band with the ritual broken into its four stages. -->
  <section class="section section--dark banya" aria-labelledby="banya-heading">
    <div class="container">
      <div class="banya__head">
        <h2 id="banya-heading">Traditional Russian Banya Near Hauz Khas</h2>
        <p>
          The banya is where the word Russian in our name comes from, and it is not a massage. It is
          a bathing ritual built around heat and run in rounds, which is why it feels so unlike an
          hour face-down on a table. You are moving between rooms, warming through, cooling off and
          going back in, rather than lying still throughout.
        </p>
        <p>
          The difference most guests notice is the pace. A massage runs to the clock; the banya is
          deliberately interrupted, and the breaks matter as much as the steam. At
          <strong>₹2,500 for 60 minutes</strong> it is also the least expensive treatment on the
          menu.
        </p>
      </div>

      <ol class="stages">
        {
          banyaStages.map((stage) => (
            <li class="stage">
              <span class="stage__num" aria-hidden="true">
                {stage.step}
              </span>
              <h3 class="stage__title">{stage.title}</h3>
              <p class="stage__text">{stage.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================================================== 5. PREFERENCE ==== -->
  <section class="section" aria-labelledby="preference-heading">
    <div class="container pref">
      <div class="pref__media">
        <picture>
          <source
            type="image/webp"
            srcset={srcSet(oilsArt.webpSmall, oilsArt.webp, 620, 1000)}
            sizes="(min-width: 900px) 460px, 92vw"
          />
          <img
            src={hauzKhasImages.oils.src}
            srcset={srcSet(oilsArt.jpgSmall, hauzKhasImages.oils.src, 620, 1000)}
            sizes="(min-width: 900px) 460px, 92vw"
            alt={hauzKhasImages.oils.alt}
            width={hauzKhasImages.oils.width}
            height={hauzKhasImages.oils.height}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>

      <div class="pref__copy">
        <h2 id="preference-heading">A Massage Experience Designed Around Your Preference</h2>
        <p>
          Nothing has to be decided on the table. Before a session starts, the therapist asks what
          you want from it, and the more specific you are, the closer the hour lands to what you had
          in mind. Guests who say nothing get a perfectly good general massage; guests who mention
          the shoulder, the pressure and the fact that they would rather not chat get something
          noticeably better suited to them.
        </p>
        <p>
          You can change your mind partway through, too. If the pressure creeps past comfortable, or
          you would rather more time went on your legs than your back, say so &mdash; it is adjusted
          from that point on. Six things worth mentioning first:
        </p>

        <ul class="pref__list">
          {
            preferencePoints.map((point) => (
              <li>
                <strong>{point.title}</strong> &mdash; {point.body}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================= 6. NEARBY CONVENIENCE ==== -->
  <section class="section section--cream" aria-labelledby="nearby-heading">
    <div class="container narrow">
      <h2 id="nearby-heading">Convenient for Hauz Khas and Nearby Areas</h2>
      <p>
        Hauz Khas sits in the middle of a well-connected stretch of South Delhi, which is why guests
        booking with us come from well beyond it. Green Park and Malviya Nagar are regular starting
        points, as are Saket, Greater Kailash and the Chhatarpur side, while Vasant Kunj and Vasant
        Vihar guests are already heading in our direction.
      </p>
      <p>
        We have one spa, in Aerocity, so none of these are branches &mdash; they are simply the
        neighbourhoods people travel in from. Guests coming from nearby South Delhi areas can
        contact us to check availability and directions before setting off, which is the sensible
        order given how much the journey time across this part of the city depends on when you
        leave. We do not publish distances or travel times for any of them; the map further down the
        page will work out your route far better than a number here could.
      </p>

      <ul class="areas" aria-label="South Delhi areas guests travel from">
        {nearbyAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
  </section>

  <!-- ==================================== 7 + 8. LOCAL SEARCH, TWO-UP ==== -->
  <section class="section" aria-label="Where the spa is, for local searches">
    <div class="container twoup">
      <article class="panel">
        <h2>Spa Near Hauz Khas in South Delhi</h2>
        <p>
          A search for a spa near Hauz Khas, a body massage in South Delhi or a massage centre
          nearby usually surfaces whatever is closest rather than whatever fits. We are worth a look
          for a different reason: the spa is not in Hauz Khas, it is in Aerocity, but it carries a
          full treatment menu, publishes every price, and is open until 11:00 PM seven days a week.
        </p>
        <p>
          If distance is the deciding factor, somewhere closer will win. If the treatment, the
          facilities or the banya matter more, the journey across South Delhi is the trade you are
          making.
        </p>
      </article>

      <article class="panel">
        <h2>Spa Near Delhi Airport</h2>
        <p>
          The same address answers a second search entirely. Aerocity is the hotel and business
          district beside Indira Gandhi International Airport, so a spa near Delhi Airport and a spa
          reachable from Hauz Khas are, in our case, the same place &mdash; which is why guests
          flying through IGI and guests living in South Delhi end up on the same booking list.
        </p>
        <p>
          We do not publish a travel time from any terminal or from Hauz Khas. It depends entirely on
          your route and the hour. Use the map below, and leave more room than you think you need if
          a flight follows.
        </p>
      </article>
    </div>
  </section>

  <!-- ================================================== 9. FACILITIES ==== -->
  <section class="section section--cream" aria-labelledby="facilities-heading">
    <div class="container">
      <div class="section__head">
        <h2 id="facilities-heading">Spa Facilities</h2>
        <p class="muted">
          What is on site. Not every facility forms part of every treatment &mdash; check what your
          booking includes when the team confirms it.
        </p>
      </div>

      <div class="fac-wrap">
        <ul class="fac-grid">
          {
            hauzKhasFacilities.map((facility) => (
              <li class="fac">
                <span class="fac__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
                    <path d={facilityIcons[facility.icon]} />
                  </svg>
                </span>
                <h3 class="fac__name">{facility.name}</h3>
                <p class="fac__text">{facility.body}</p>
              </li>
            ))
          }
        </ul>

        <figure class="fac-photo">
          <picture>
            <source
              type="image/webp"
              srcset={srcSet(calmArt.webpSmall, calmArt.webp, 500, 1000)}
              sizes="(min-width: 1000px) 340px, 92vw"
            />
            <img
              src={hauzKhasImages.calm.src}
              srcset={srcSet(calmArt.jpgSmall, hauzKhasImages.calm.src, 500, 1000)}
              sizes="(min-width: 1000px) 340px, 92vw"
              alt={hauzKhasImages.calm.alt}
              width={hauzKhasImages.calm.width}
              height={hauzKhasImages.calm.height}
              loading="lazy"
              decoding="async"
            />
          </picture>
          <figcaption>
            More of the spa is on show in our <a href="/gallery/">spa gallery</a>.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===================================================== 10. PRICES ==== -->
  <section class="section" aria-labelledby="prices-heading">
    <div class="container narrow">
      <div class="section__head">
        <h2 id="prices-heading">Massage Prices Near Hauz Khas</h2>
        <p class="muted">
          The published menu. These are the same figures quoted when you book &mdash; there is no
          separate rate depending on where you travel in from.
        </p>
      </div>

      <table class="ptable">
        <caption class="sr-only">Massage treatments with session length and price</caption>
        <thead>
          <tr>
            <th scope="col">Treatment</th>
            <th scope="col">Session</th>
            <th scope="col">Price</th>
          </tr>
        </thead>
        <tbody>
          {
            hauzKhasPrices.map((row) => (
              <tr>
                <th scope="row">{row.name}</th>
                <td>{row.duration}</td>
                <td class="ptable__price">{row.price}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <p class="offer-note">
        <strong>First visit full body massage &mdash; ₹1,499.</strong> An introductory price for the
        full body massage, on a first appointment only. It is not a reduction on the treatments
        listed above or on the packages, which are priced as shown.
      </p>

      <div class="centre-row">
        <a class="btn btn--outline" href="/pricing/">View Full Pricing</a>
      </div>
    </div>
  </section>

  <!-- ==================================================== 11. EXPECT ==== -->
  <section class="section section--cream" aria-labelledby="expect-heading">
    <div class="container narrow">
      <div class="section__head">
        <h2 id="expect-heading">What Guests Can Expect</h2>
      </div>
      <ul class="ticks">
        {expectPoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <!-- ================================================== 12. LOCATION ==== -->
  <section class="section" aria-labelledby="visit-heading">
    <div class="container narrow">
      <div class="section__head">
        <h2 id="visit-heading">Location &amp; Directions</h2>
        <p class="muted">
          This page targets guests searching from Hauz Khas and South Delhi. The spa itself is in
          Aerocity, and the address below and the map are the real ones &mdash; there is no separate
          Hauz Khas outlet.
        </p>
      </div>

      <dl class="details">
        <div>
          <dt>Address</dt>
          <dd>{site.addressLine}</dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd><a href={telHref}>{site.phone}</a></dd>
        </div>
        <div>
          <dt>WhatsApp</dt>
          <dd>{site.phone} &mdash; same number, message any time</dd>
        </div>
        <div>
          <dt>Opening hours</dt>
          <dd>{site.openingHoursLabel}</dd>
        </div>
        <div>
          <dt>Directions</dt>
          <dd>
            Open the listing below for a route from wherever you are starting.
          </dd>
        </div>
      </dl>

      <div class="centre-row">
        <a class="btn" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
          Get Directions
        </a>
      </div>

      <!--
        Below the copy and lazy-loaded, so it never competes with the content
        above it. The Get Directions link works whether or not the embed does.
      -->
      <iframe
        class="map"
        src={mapSrc}
        title={`Map showing ${site.name} at ${site.addressLine}`}
        width="860"
        height="400"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>

      <p class="muted small">
        Please book before you travel &mdash; walk-ins depend entirely on what happens to be free.
        <a href="/contact/">Contact us</a> for anything this page does not answer, or read more
        <a href="/about/">about our spa</a> and see <a href="/pricing/">our massage pricing</a>.
      </p>
    </div>
  </section>

  <!-- ====================================================== 13. BOOKING ==== -->
  <section class="section section--cream" aria-labelledby="book-heading">
    <div class="container">
      <div class="section__head">
        <h2 id="book-heading">How to Book Your Massage</h2>
        <p class="muted">
          Five steps, no account and no deposit. Your appointment is booked when the team confirms
          it, not when you send the message.
        </p>
      </div>

      <div class="booking">
        <ol class="steps">
          {
            hauzKhasSteps.map((item) => (
              <li class="step">
                <span class="step__num" aria-hidden="true">
                  {item.step}
                </span>
                <h3 class="step__title">{item.title}</h3>
                <p class="step__text">{item.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="booking__media">
          <picture>
            <source
              type="image/webp"
              srcset={srcSet(bookingArt.webpSmall, bookingArt.webp, 620, 1200)}
              sizes="(min-width: 1000px) 380px, 92vw"
            />
            <img
              src={hauzKhasImages.booking.src}
              srcset={srcSet(bookingArt.jpgSmall, hauzKhasImages.booking.src, 620, 1200)}
              sizes="(min-width: 1000px) 380px, 92vw"
              alt={hauzKhasImages.booking.alt}
              width={hauzKhasImages.booking.width}
              height={hauzKhasImages.booking.height}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      </div>

      <div class="centre-row centre-row--gap">
        <CTA
          label="Book on WhatsApp"
          message="Hi, I would like to book a massage appointment. I am travelling in from the Hauz Khas area."
        />
        <a class="btn btn--outline" href={telHref}>Call {site.phone}</a>
      </div>
    </div>
  </section>

  <!-- ========================================================= 14. FAQ ==== -->
  <section class="section" aria-labelledby="faq-heading">
    <div class="container narrow">
      <div class="section__head">
        <h2 id="faq-heading">Hauz Khas Guests &mdash; Frequently Asked Questions</h2>
      </div>
      <FAQ faqs={hauzKhasFaqs} questionTag="h3" />
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 860px;
  }

  .narrow > h2,
  .narrow > p {
    max-width: 72ch;
  }

  .narrow > p {
    margin-top: 1rem;
  }

  .centre-row {
    display: flex;
